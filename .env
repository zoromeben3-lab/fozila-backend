# ══════════════════════════════════════
#  FOZILA — Variables d'environnement
#  ⚠️  Ne jamais commit ce fichier sur Git
# ══════════════════════════════════════

# Serveur
PORT=3000
NODE_ENV=development

# JWT — change cette clé par une chaîne longue et aléatoire
JWT_SECRET=fozila_secret_change_moi_en_production_2024

# JWT expiration
JWT_EXPIRES_IN=7d

# Admin par défaut (créé automatiquement au init-db)
ADMIN_EMAIL=admin@fozila.com
ADMIN_PASSWORD=fozila2026
ADMIN_NAME=Administrateur

# Chemin base de données
DB_PATH=./db/fozila.db

# Taille max fichier audio (en octets) — ici 100 Mo
MAX_AUDIO_SIZE=104857600

# Taille max image cover — ici 5 Mo
MAX_COVER_SIZE=5242880
